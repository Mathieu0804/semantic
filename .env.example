# Base de données (SQLite local)
DATABASE_URL="file:./dev.db"

# URL de l'application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ══════════════════════════════════════════════════════════
# CONFIGURATION IA - CHOISIR L'UNE DES DEUX OPTIONS
# ══════════════════════════════════════════════════════════

# OPTION 1 : Gemini API (pour Render.com et cloud)
# ─────────────────────────────────────────────────
# Obtenir une clé : https://makersuite.google.com/app/apikey
GEMINI_API_KEY="votre_cle_api_gemini_ici"
GEMINI_MODEL="gemini-pro"

# OPTION 2 : Ollama (pour développement local uniquement)
# ─────────────────────────────────────────────────────────
# URL où Ollama est accessible (par défaut localhost)
# OLLAMA_API_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3"

# Configuration commune IA
AI_TEMPERATURE="0.7"
AI_MAX_TOKENS="2048"

# Sécurité
# Générer avec: openssl rand -base64 32
JWT_SECRET="votre_secret_jwt_32_caracteres_minimum"

# Environnement
NODE_ENV="development"

# Analytics
ENABLE_ANALYTICS="true"

# Tâches automatiques (en minutes)
TASK_INTERVAL="60"  # Exécuter les agents toutes les heures
RAPPORT_INTERVAL="10080"  # Rapport hebdomadaire (7 jours * 24h * 60min)
