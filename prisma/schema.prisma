// prisma/schema.prisma
// Schéma avec tables pour l'auto-modification

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


// ════════════════════════════════════════════════════════════
// ENTREPRISE - Identité et configuration
// ════════════════════════════════════════════════════════════
model Entreprise {
  id              int   @id 
  nom             String
  slogan          String?
  email           String
  telephone       String
  adresse         String?
  descriptionBreve String?
  descriptionLongue String?  // Pas de @db.Text avec SQLite
  logo            String?
  couleurPrimaire String   @default("#3B82F6")
  couleurSecondaire String @default("#10B981")
  reseauxSociaux  String   @default("{}")  // JSON stocké en String
  
  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String   @default("[]")  // JSON stocké en String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  produits        Produit[]
  siteGenere      SiteGenere[]
  conversations   Conversation[]
  rapports        Rapport[]
  
  @@map("entreprises")
}

// ════════════════════════════════════════════════════════════
// PRODUITS / SERVICES - Catalogue
// ════════════════════════════════════════════════════════════
model Produit {
  id              String   @id @default(cuid())
  entrepriseId    String
  
  nom             String
  description     String
  prix            Float
  prixPromo       Float?
  devise          String   @default("EUR")
  
  categorie       String?
  tags            String   @default("[]")  // JSON stocké en String
  
  stock           Int      @default(0)
  stockMin        Int      @default(5)
  enVente         Boolean  @default(true)
  
  images          String   @default("[]")  // JSON stocké en String
  
  // SEO
  slug            String   @unique
  metaDescription String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  entreprise      Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  interactions    InteractionProduit[]
  
  @@index([entrepriseId])
  @@index([categorie])
  @@index([slug])
  @@map("produits")
}

// ════════════════════════════════════════════════════════════
// SITE WEB GÉNÉRÉ
// ════════════════════════════════════════════════════════════
model SiteGenere {
  id              String   @id @default(cuid())
  entrepriseId    String
  
  version         Int      @default(1)
  actif           Boolean  @default(false)
  
  configuration   String   // JSON stocké en String
  codeHTML        String
  codeCSS         String
  codeJS          String?
  
  ldJson          String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  entreprise      Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  
  @@index([entrepriseId])
  @@index([actif])
  @@map("sites_generes")
}

// ════════════════════════════════════════════════════════════
// CONVERSATIONS - Historique chatbot
// ════════════════════════════════════════════════════════════
model Conversation {
  id              String   @id @default(cuid())
  entrepriseId    String?
  sessionId       String   @unique
  
  contexte        String
  metadata        String   @default("{}")  // JSON stocké en String
  
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  entreprise      Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  messages        Message[]
  
  @@index([sessionId])
  @@index([entrepriseId])
  @@map("conversations")
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  
  role            String
  content         String
  metadata        String   @default("{}")  // JSON stocké en String
  
  createdAt       DateTime @default(now())
  
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@index([conversationId])
  @@map("messages")
}

// ════════════════════════════════════════════════════════════
// ANALYTICS - Interactions et patterns
// ════════════════════════════════════════════════════════════
model InteractionProduit {
  id              String   @id @default(cuid())
  produitId       String
  
  type            String
  source          String?
  metadata        String   @default("{}")  // JSON stocké en String
  
  timestamp       DateTime @default(now())
  
  produit         Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  
  @@index([produitId])
  @@index([type])
  @@index([timestamp])
  @@map("interactions_produits")
}

model Email {
  id              String   @id @default(cuid())
  
  de              String
  destinataire    String
  sujet           String
  contenu         String
  
  type            String
  sentiment       String?
  
  traite          Boolean  @default(false)
  reponse         String?
  
  createdAt       DateTime @default(now())
  
  @@index([type])
  @@index([traite])
  @@index([createdAt])
  @@map("emails")
}

// ════════════════════════════════════════════════════════════
// RAPPORTS - Analyses hebdomadaires de l'IA
// ════════════════════════════════════════════════════════════
model Rapport {
  id              String   @id @default(cuid())
  entrepriseId    String
  
  type            String
  titre           String
  contenu         String
  
  insights        String   @default("[]")  // JSON stocké en String
  recommandations String   @default("[]")  // JSON stocké en String
  
  lu              Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  
  entreprise      Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  
  @@index([entrepriseId])
  @@index([type])
  @@index([lu])
  @@index([createdAt])
  @@map("rapports")
}

// ════════════════════════════════════════════════════════════
// TÂCHES - Queue pour l'IA agentique
// ════════════════════════════════════════════════════════════
model Tache {
  id              String   @id @default(cuid())
  
  type            String
  priorite        Int      @default(5)
  
  statut          String   @default("en_attente")
  
  input           String   // JSON stocké en String
  output          String?  // JSON stocké en String
  
  erreur          String?
  
  createdAt       DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  
  @@index([statut])
  @@index([priorite])
  @@index([createdAt])
  @@map("taches")
}
// ═══════════════════════════════════════════
// NOUVELLES TABLES - AI BUILDER
// ═══════════════════════════════════════════

// Versions des composants/fichiers
model ComponentVersion {
  id          String   @id @default(cuid())
  
  filePath    String   // ex: "src/app/page.tsx"
  fileName    String   // ex: "page.tsx"
  code        String   // Le code complet du fichier
  
  description String   // Description de la modification
  version     Int      // Numéro de version incrémental
  metadata    String   @default("{}")  // JSON: action, timestamp, etc
  
  createdBy   String   @default("ai")
  createdAt   DateTime @default(now())
  
  @@index([filePath])
  @@index([version])
  @@map("component_versions")
}

// Historique des actions du builder
model BuilderAction {
  id          String   @id @default(cuid())
  
  action      String   // "create", "modify", "delete"
  target      String   // Fichier cible
  prompt      String   // Demande utilisateur originale
  code        String?  // Code généré
  
  applied     Boolean  @default(false)
  success     Boolean?
  error       String?
  
  versionId   String?  // Lien vers ComponentVersion si succès
  
  createdAt   DateTime @default(now())
  
  @@index([action])
  @@index([applied])
  @@index([createdAt])
  @@map("builder_actions")
}

// Prévisualisations temporaires (optionnel)
model Preview {
  id          String   @id @default(cuid())
  code        String   // Code à prévisualiser
  filePath    String   // Fichier concerné
  expiresAt   DateTime // Auto-suppression après X temps
  createdAt   DateTime @default(now())
  
  @@index([expiresAt])
  @@map("previews")
}
