// ============================================
// PLATEFORME IA LOCALE - SCHEMA BASE DE DONNEES
// Pour PME/PMI - Souveraineté des données
// SQLite Version
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// UTILISATEURS ET AUTHENTIFICATION
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String?
  role          String   @default("user") // user, admin
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  sites         Site[]
  dialogues     Dialogue[]
  analytics     VisitorAnalytics[]
  
  @@map("users")
}

// ============================================
// IDENTITÉ ENTREPRISE
// ============================================

model CompanyIdentity {
  id                String   @id @default(cuid())
  name              String
  description       String?
  slogan            String?
  logo              String?  // URL ou base64
  primaryColor      String?  @default("#3B82F6")
  secondaryColor    String?  @default("#1E40AF")
  accentColor       String?  @default("#10B981")
  
  // Contact
  email             String?
  phone             String?
  address           String?
  city              String?
  postalCode        String?
  country           String?
  website           String?
  
  // Réseaux sociaux
  facebook          String?
  twitter           String?
  linkedin          String?
  instagram         String?
  
  // SEO
  metaTitle         String?
  metaDescription   String?
  keywords          String?  // Séparés par virgule
  
  // LD-JSON
  ldJson            String?  // JSON stringifié
  businessType      String?  @default("LocalBusiness") // Schema.org type
  
  // IA Configuration
  aiPersonality     String?  // Prompt système pour l'IA
  aiTone            String?  @default("professionnel") // professionnel, amical, formel...
  aiExpertise       String?  // Domaines d'expertise
  
  // MCP Server
  mcpServerUrl      String?  // URL du serveur MCP
  mcpEnabled        Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("company_identities")
}

// ============================================
// SITES WEB CRÉÉS
// ============================================

model Site {
  id                String   @id @default(cuid())
  userId            String
  name              String
  domain            String?  @unique
  description       String?
  
  // Contenu généré
  htmlContent       String?
  cssContent        String?
  jsContent         String?
  
  // Configuration
  theme             String?  @default("modern")
  language          String?  @default("fr")
  
  // SEO du site
  metaTitle         String?
  metaDescription   String?
  ldJson            String?
  
  // Statut
  status            String   @default("draft") // draft, published, archived
  publishedAt       DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages             Page[]
  products          Product[]
  services          Service[]
  analytics         VisitorAnalytics[]
  
  @@map("sites")
}

model Page {
  id                String   @id @default(cuid())
  siteId            String
  name              String
  slug              String
  title             String?
  content           String?
  
  // SEO
  metaTitle         String?
  metaDescription   String?
  ldJson            String?
  
  // Ordre et statut
  order             Int      @default(0)
  status            String   @default("draft")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  @@unique([siteId, slug])
  @@map("pages")
}

// ============================================
// CATALOGUE PRODUITS ET SERVICES
// ============================================

model Product {
  id                String   @id @default(cuid())
  siteId            String
  
  // Infos principales
  name              String
  description       String?
  shortDescription  String?
  reference         String?  @unique
  sku               String?
  
  // Prix
  price             Float?
  currency          String?  @default("EUR")
  discountPrice     Float?
  taxRate           Float?   @default(20.0)
  
  // Médias
  images            String?  // JSON array of URLs
  mainImage         String?
  
  // Catégorisation
  category          String?
  subcategory       String?
  tags              String?  // JSON array
  
  // Stock
  stock             Int?
  stockStatus       String?  @default("in_stock") // in_stock, out_of_stock, on_order
  minOrder          Int?     @default(1)
  
  // SEO
  metaTitle         String?
  metaDescription   String?
  ldJson            String?  // Product schema
  
  // Statut
  status            String   @default("active") // active, inactive, archived
  featured          Boolean  @default(false)
  
  // Analytics
  viewCount         Int      @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  @@map("products")
}

model Service {
  id                String   @id @default(cuid())
  siteId            String
  
  // Infos principales
  name              String
  description       String?
  shortDescription  String?
  reference         String?
  
  // Tarification
  basePrice         Float?
  currency          String?  @default("EUR")
  pricingType       String?  @default("fixed") // fixed, hourly, quote
  duration          String?  // Durée estimée
  
  // Médias
  images            String?
  mainImage         String?
  
  // Catégorisation
  category          String?
  tags              String?
  
  // SEO
  metaTitle         String?
  metaDescription   String?
  ldJson            String?  // Service schema
  
  // Statut
  status            String   @default("active")
  featured          Boolean  @default(false)
  
  // Analytics
  viewCount         Int      @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  @@map("services")
}

model Category {
  id                String   @id @default(cuid())
  name              String
  description       String?
  slug              String   @unique
  parentId          String?
  image             String?
  order             Int      @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("categories")
}

// ============================================
// DIALOGUES ET INTERACTIONS IA
// ============================================

model Dialogue {
  id                String   @id @default(cuid())
  userId            String?
  sessionId         String
  
  // Type de dialogue
  type              String   @default("user") // user, mcp, ia_to_ia
  
  // Source
  source            String?  // web, mcp_server, api
  visitorId         String?
  
  // Contenu
  userMessage       String?
  aiResponse        String?
  
  // Contexte
  context           String?  // JSON: page, produits consultés, etc.
  intent            String?  // Création site, question produit, etc.
  sentiment         String?  // positif, neutre, négatif
  
  // Métadonnées
  responseTime      Int?     // ms
  tokensUsed        Int?
  
  // Feedback
  rating            Int?     // 1-5
  feedback          String?
  
  createdAt         DateTime @default(now())
  
  user              User?    @relation(fields: [userId], references: [id])
  
  @@index([sessionId])
  @@index([visitorId])
  @@map("dialogues")
}

// ============================================
// ANALYTICS ET COMPORTEMENT VISITEURS
// ============================================

model VisitorAnalytics {
  id                String   @id @default(cuid())
  siteId            String?
  userId            String?
  visitorId         String
  
  // Session
  sessionId         String
  sessionDuration   Int?     // secondes
  
  // Device
  deviceType        String?  // desktop, mobile, tablet
  browser           String?
  os                String?
  screenWidth       Int?
  
  // Localisation
  country           String?
  city              String?
  ip                String?
  
  // Pages visitées
  pagesVisited      String?  // JSON array
  entryPage         String?
  exitPage          String?
  
  // Actions
  productsViewed    String?  // JSON array of product IDs
  searchQueries     String?  // JSON array
  
  // Conversions
  conversions       String?  // JSON array
  conversionValue   Float?
  
  // Source
  referrer          String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  
  createdAt         DateTime @default(now())
  
  site              Site?    @relation(fields: [siteId], references: [id])
  user              User?    @relation(fields: [userId], references: [id])
  
  @@index([visitorId])
  @@index([sessionId])
  @@map("visitor_analytics")
}

// ============================================
// PATTERNS ET INSIGHTS IA
// ============================================

model Pattern {
  id                String   @id @default(cuid())
  
  // Type de pattern
  type              String   // product_interest, service_demand, navigation, conversion
  category          String?
  
  // Données du pattern
  pattern           String?  // JSON: règles, fréquences, corrélations
  insights          String?  // JSON: analyses, recommandations
  
  // Importance
  confidence        Float?   // 0-1
  frequency         Int      @default(1)
  
  // Période
  periodStart       DateTime?
  periodEnd         DateTime?
  
  // Actions suggérées
  suggestions       String?  // JSON array
  
  // Statut
  status            String   @default("active") // active, reviewed, implemented
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("patterns")
}

// ============================================
// MCP - INTERCONNEXION IA TO IA
// ============================================

model MCPConnection {
  id                String   @id @default(cuid())
  
  // Client
  clientName        String?
  clientType        String?  // phone, computer, assistant
  clientIp          String?
  
  // Session
  sessionId         String   @unique
  token             String   @unique
  
  // Permissions
  permissions       String?  // JSON array
  rateLimit         Int?     @default(100) // req/heure
  
  // Statut
  status            String   @default("active") // active, suspended, revoked
  lastActivity      DateTime?
  
  // Stats
  totalRequests     Int      @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("mcp_connections")
}

model MCPRequest {
  id                String   @id @default(cuid())
  connectionId      String
  
  // Requête
  endpoint          String
  method            String
  payload           String?
  
  // Réponse
  response          String?
  statusCode        Int?
  responseTime      Int?     // ms
  
  // Contexte
  context           String?  // JSON
  
  createdAt         DateTime @default(now())
  
  @@index([connectionId])
  @@map("mcp_requests")
}

// ============================================
// CONFIGURATION SYSTÈME
// ============================================

model SystemConfig {
  id                String   @id @default(cuid())
  key               String   @unique
  value             String?
  description       String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("system_configs")
}

// ============================================
// TÂCHES AUTOMATISÉES
// ============================================

model ScheduledTask {
  id                String   @id @default(cuid())
  name              String
  type             String   // seo_update, pattern_analysis, backup
  
  // Planification
  frequency        String   // hourly, daily, weekly
  lastRun          DateTime?
  nextRun          DateTime?
  
  // Configuration
  config           String?  // JSON
  
  // Statut
  status           String   @default("active")
  lastResult       String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@map("scheduled_tasks")
}
